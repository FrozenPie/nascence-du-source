+def _ram_guard_before_load() -> None:
+    """J-4350 / D-0761: defer a cold load while the box is RAM-starved (yi:34b is ~20 GB; loading it at 0.5-1.1 GB
+    ram_avail pushes hot_ollama/judges into the read timeouts the supervisor logged). --min-ram-load-gb 0 = off
+    (default); --ram-guard-shadow = log only, never defer. Polls up to --ram-wait-s, then raises so the caller's
+    existing fail-open path runs. Fail-open: no psutil / any error -> load as before."""
+    gb = getattr(_ARGS, "min_ram_load_gb", 0.0) or 0.0
+    if gb <= 0:
+        return
+    try:
+        import psutil
+        deadline = time.time() + float(getattr(_ARGS, "ram_wait_s", 30.0))
+        while True:
+            avail = psutil.virtual_memory().available / 2**30
+            if avail >= gb:
+                return
+            if getattr(_ARGS, "ram_guard_shadow", False):
+                print(f"[{_ts()}] [cpu-tier] {ALIAS} RAM-GUARD(shadow): ram_avail={avail:.1f}GB < {gb}GB, loading anyway")
+                return
+            if time.time() >= deadline:
+                print(f"[{_ts()}] [cpu-tier] {ALIAS} RAM-GUARD: load deferred, ram_avail={avail:.1f}GB < {gb}GB")
+                raise RuntimeError(f"load deferred: ram_avail={avail:.1f}GB < {gb}GB")
+            time.sleep(2.0)
+    except RuntimeError:
+        raise
+    except Exception:
+        return
+
